# Учётная запись на login.1c.ru (нужна только для скачивания документации)
USERNAME=your_username
PASSWORD=your_password

# Логирование
LOG_LEVEL=INFO
LOG_FILE=
LOG_FILE_LEVEL=DEBUG

# RAG / MCP (значения по умолчанию указаны справа от знака =)
# Каталог со скачанными базами (out/<db>)
ITS_OUT_DIR=out
# Корень данных: Qdrant в <ITS_DATA_DIR>/qdrant, кэш моделей в <ITS_DATA_DIR>/models
ITS_DATA_DIR=data
# Путь локального хранилища Qdrant (по умолчанию <ITS_DATA_DIR>/qdrant)
ITS_QDRANT_PATH=
# Внешний Qdrant-сервер; если задан, ITS_QDRANT_PATH не используется
ITS_QDRANT_URL=
# Модели fastembed: dense (для e5 префиксы query:/passage: добавляются автоматически) и sparse
ITS_DENSE_MODEL=intfloat/multilingual-e5-large
ITS_SPARSE_MODEL=Qdrant/bm25
# Каталог кэша моделей (по умолчанию <ITS_DATA_DIR>/models)
ITS_MODELS_CACHE=
# Адрес и порт its-mcp --transport http
ITS_MCP_HOST=127.0.0.1
ITS_MCP_PORT=8080
